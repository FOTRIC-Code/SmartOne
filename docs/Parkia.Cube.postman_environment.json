      "description": "设备 ID（可选，由 GET device_info 手动填写）"
    },
    {
      "key": "serial_no",
      "value": "",
      "type": "default",
      "enabled": true,
      "description": "序列号（可选，由 GET device_info 手动填写）"
    },
    {
      "key": "setup_code",
      "value": "123456",
      "type": "default",
      "enabled": true,
      "description": "默认配网码"
    },
    {
      "key": "wifi_ssid",
      "value": "YourHomeWiFi",
      "type": "default",
      "enabled": true
    },
    {
      "key": "wifi_pwd",
      "value": "YourWiFiPassword",
