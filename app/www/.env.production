# 网站根目录
VITE_PUBLIC_PATH = /

# 是否删除console
VITE_DROP_CONSOLE = true

# gzip 预压缩（可选旁路）；Parkia mongoose 需保留未压缩实体
VITE_BUILD_COMPRESS = 'gzip'

# 必须 false：net_app/mongoose 不会像 busybox httpd 那样自动回落 .gz
VITE_BUILD_COMPRESS_DELETE_ORIGIN_FILE = false

# WebRTC SDP 交换端口（ZLM_HTTP_PORT = 8080，与 Holly 一致）
VITE_GLOB_API_WEBRTC_PORT = 8080
