# 只在开发模式中被载入
VITE_PORT = 5173

# 网站根目录
VITE_PUBLIC_PATH = ./

# 是否删除console
VITE_DROP_CONSOLE = false

# 跨域代理：开发时将 API 请求代理到设备（避免 CORS）
VITE_PROXY=[["/api","http://192.168.1.100"]]

# 开发直连设备 ZLM（可选）。留空则走同源 /media/webrtc（需设备已含代理）
VITE_GLOB_API_WEBRTC_URL = http://192.168.1.100
VITE_GLOB_API_WEBRTC_PORT = 8080
