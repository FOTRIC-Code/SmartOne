BR2_PACKAGE_PYTHON_PERIPHERY=y
BR2_PACKAGE_PYTHON_SPIDEV=y
BR2_PACKAGE_PYTHON_SMBUS_CFFI=y

# ── 调试用工具（按需求开启）─────────────────────────────────────────
BR2_PACKAGE_NANO=y
BR2_PACKAGE_DIALOG=y

